# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Meta Model API key (required; lives only on the server)
MODEL_API_KEY=
# Optional; defaults to https://api.meta.ai/v1 when empty
META_API_BASE_URL=
# Optional (web app): local port and where runs are written
# PORT=5000
# RUNS_WEB=/tmp/runs/web
